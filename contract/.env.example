# Copy to contract/.env and fill in. This file is git-ignored — never commit it.
# Generate/find a testnet wallet and fund it from https://faucet.monad.xyz
PRIVATE_KEY=0x...

MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Optional: needed only for `--verify` on monadscan
MONADSCAN_API_KEY=

# Deploy params (defaults: free mint, 1000 supply)
MINT_PRICE=0
MAX_SUPPLY=1000