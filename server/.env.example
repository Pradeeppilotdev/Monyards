# Lanyard bake server config — copy to .env and fill in.
#
# Required before real pinning: a Pinata JWT (https://app.pinata.cloud).
# Without it the server runs in DRY RUN mode and returns fake, non-resolvable
# CIDs so the full mint flow can be exercised locally.
PINATA_JWT=

# Chain + contract the mint frontend should target (Monad testnet by default).
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadscan.com

PORT=8787
# Optional: dedicated Pinata gateway for share-clip URLs (faster than ipfs.io)
# PINATA_GATEWAY=https://<subdomain>.gateway.pinata.cloud
